<h1>投稿一覧</h1>

<table>

<tr>
<th>本のタイトル</th>
<th>感想</th>
<th></th>
</tr>
</thead>

<tbody>
<% @books.each do |book| %>

<tr>
<td><p><%= book.title %></p></td>
<td><p><%= book.body %></p></td>
<td colspan="3"><%= link_to "Show", book_path(book.id) %></td>
<td><%= link_to "Edit", edit_book_path(book.id) %></td>
<td><%= link_to "Destroy", book_path(book.id), data: { turbo_method: :delete, turbo_confirm: "本当に削除しますか？"} %></td>
</tr>

<% end %>
</tbody>
</table>


<h2>新規投稿</h2>
<%if @book.errors.any? %>
  <%= @book.errors.count %>error prohibited this book from being saved:
  <ul>
    <% @book.errors.full_messages.each do |message|%>
      <li><%= message %></li>
    <% end %>
  </ul>
<% end %>


<%= form_with model: @book do |f| %>

  <p>本のタイトル</p>
  <%= f.text_field :title %>

  <p>感想</p>
  <%= f.text_area :body %>

  <%= f.submit "Create Book" %>

<% end %>