<h1>投稿一覧</h1>

<table>

<tr>
<th>本のタイトル</th>
<th>感想</th>
<th></th>
<tr>
</thead>

<tbody>
<% @books.each do |book| %>

<tr>
<td><p><%= book.title %></p></td>
<td><p><%= book.body %></p></td>
<td colspan="3"><%= link_to "閲覧", book_path(book.id) %></td>
<td><%= link_to "編集", edit_book_path(book.id) %></td>
<td><%= link_to "削除", book_path(book.id), data: { turbo_method: :delete, turbo_confirm: "本当に削除しますか？"} %></td>
</tr>

<% end %>
</tbody>
<table>


<h2>新規投稿</h2>
<%= form_with model: @book do |f| %>

  <p>本のタイトル</p>
  <%= f.text_field :title %>

  <p>感想</p>
  <%= f.text_area :body %>

  <%= f.submit "本を投稿" %>

<% end %>